{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "InternshipPlatform",
    "Audience": "InternshipPlatform",
    "SigningKey": "local-development-signing-key-change-before-production-2026",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Program": {
    "TargetHours": 200,
    "LowProgressThresholdPercent": 50
  }
}
